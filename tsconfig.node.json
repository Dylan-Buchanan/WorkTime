{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "vitest.integration.config.ts", "src/lib/**/*.ts", "src/state/types.ts", "src/vite-env.d.ts", "tests/**/*.ts", "e2e/**/*.ts"]
}
