# Server-side secret for the invite-signup Edge Function. Copy this file to
# .env.local and set a temporary local value; .env.local is git-ignored.
SIGNUP_INVITE_CODE=replace-with-a-local-secret

# Server-only Google Calendar OAuth web-client configuration. The redirect URI
# must exactly match the google-calendar-auth function URL registered in Google
# Cloud. Return origins are comma-separated and validated before redirecting.
GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/google-calendar-auth
GOOGLE_CALENDAR_ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tauri.localhost
