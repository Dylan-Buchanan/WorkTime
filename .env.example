# The anon key is safe for browser use and is restricted by Supabase RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PUBLIC_APP_URL=https://worktime.pages.dev

# Never put SUPABASE_SERVICE_ROLE_KEY, SIGNUP_INVITE_CODE, or Google OAuth
# client secrets/tokens in a VITE_ variable. They belong only in server-side
# Edge Function secret configuration.
