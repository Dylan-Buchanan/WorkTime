{
    "name": "work-time",
    "private": true,
    "version": "0.5.7",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "app": "npm run tauri dev",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "sync-version": "node scripts/sync-version.mjs",
        "version": "npm run sync-version",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test:integration": "node scripts/verify-local-first-migration.mjs && vitest run --config vitest.integration.config.ts",
        "test:pwa": "npm run build && node scripts/verify-pwa-build.mjs",
        "test:platform": "node scripts/verify-platform-cleanup.mjs",
        "test:all": "npm run test:unit && npm run test:pwa && npm run test:platform && npm run test:integration && npm run test:e2e",
        "supabase:start": "npx supabase start",
        "supabase:stop": "npx supabase stop",
        "supabase:reset": "npx supabase db reset",
        "supabase:status": "npx supabase status",
        "supabase:serve": "npx supabase functions serve --env-file supabase/.env.local",
        "supabase:fullstart": "npm run supabase:start && npm run supabase:serve"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@supabase/supabase-js": "^2.112.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.2",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.25",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.2.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10",
        "workbox-window": "^7.4.1"
    }
}
